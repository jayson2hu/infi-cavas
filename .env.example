# 平台 Compose；复制为 .env。纯前端使用 docker-compose.web-only.yml 或 docker-compose.local.yml。
# 每个密码/密钥分别生成，不能复用。APP_SECRET、POSTGRES_PASSWORD、S3_SECRET_KEY：
# bun -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# S3_ACCESS_KEY 使用20字符随机标识：
# bun -e "console.log(require('node:crypto').randomBytes(10).toString('hex'))"
# 以下必填项故意留空；Compose 会拒绝空值，不提供可误用的生产密码。
POSTGRES_PASSWORD=
APP_SECRET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

POSTGRES_USER=ic
POSTGRES_DB=ic
# 填 postgres://ic:<URL编码后的POSTGRES_PASSWORD>@postgres:5432/ic
# 密码中的 @ : / ? # % 等须用 encodeURIComponent 编码；PG密码仍填未编码原值。
# 同一数据库的实例使用一致且明确包含数据库名的地址。
DATABASE_URL=

# 默认仅本机可访问。远程部署设真实HTTPS站点，并在外部反向代理转发本机3000。
APP_ORIGIN=http://localhost:3000
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
# 浏览器实际访问的S3地址，必须和签名Host一致；远端部署改为HTTPS对象存储域名。
# MinIO的9000仅绑定本机，9001控制台不公开。
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_REGION=us-east-1
# 每个环境独立bucket；不要与开发/测试共用。
S3_BUCKET=infinite-canvas

BILLING_ENABLED=true
SIGNUP_BONUS_CREDITS=200
# 每个 IP 每小时最多注册次数（0 = 不限），凭邀请链接注册不计入
SIGNUP_RATE_LIMIT_PER_HOUR=5
ALLOW_SIGNUP=true
ADMIN_EMAILS=
MODERATION_BLOCKLIST=
BRAND_NAME=
ANALYTICS_GA4_ID=
ANALYTICS_BAIDU_ID=
