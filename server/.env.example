NODE_ENV=development
PORT=8787
HOST=127.0.0.1
# Enable only behind a trusted proxy that overwrites X-Real-IP; never expose that server directly.
TRUST_PROXY=false
DATABASE_URL=postgres://ic:ic@localhost:5432/ic
APP_ORIGIN=http://localhost:3000
APP_SECRET=replace-with-at-least-32-random-characters
S3_ENDPOINT=http://localhost:9000
# Publicly reachable URL used for signed browser uploads/downloads; omit when same as S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=infinite-canvas
S3_ACCESS_KEY=ic-minio
S3_SECRET_KEY=replace-with-local-storage-password
S3_FORCE_PATH_STYLE=true
BILLING_ENABLED=true
SIGNUP_BONUS_CREDITS=200
ALLOW_SIGNUP=true
ADMIN_EMAILS=
# Comma-separated platform moderation words, distinct from brand avoidTerms.
MODERATION_BLOCKLIST=
